<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin BETSHOP</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --sidebar-bg: linear-gradient(180deg, #2f241b 0%, #3e2f22 100%);
            --sidebar-hover: rgba(255,255,255,0.12);
            --sidebar-active: linear-gradient(135deg, #d7a56d, #b76e3c);
            --primary: #b76e3c;
            --primary-dark: #8f5430;
            --primary-soft: #fff6ef;
            --secondary: #e8b07a;
            --bg: #f7f5f2;
            --card-bg: #ffffff;
            --text: #2f2a26;
            --muted: #7b6f64;
            --border: #ede3d8;
            --shadow: 0 10px 30px rgba(0,0,0,0.07);
            --danger: #d9534f;
            --success: #2e8b57;
            --warning: #d9902f;
            --info: #3578c8;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        a {
            text-decoration: none;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 280px;
            min-height: 100vh;
            background: var(--sidebar-bg);
            color: #fff;
            padding: 22px 18px;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            box-shadow: 6px 0 20px rgba(0,0,0,0.08);
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 10px 20px;
            margin-bottom: 16px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .brand-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: linear-gradient(135deg, #e8b07a, #b76e3c);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #fff;
            box-shadow: 0 8px 18px rgba(183,110,60,0.3);
        }

        .brand-text {
            display: flex;
            flex-direction: column;
        }

        .brand-title {
            font-size: 18px;
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
        }

        .brand-subtitle {
            font-size: 12px;
            color: rgba(255,255,255,0.7);
            margin-top: 3px;
        }

        .menu-group {
            margin-bottom: 20px;
        }

        .menu-title {
            padding: 8px 10px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            color: rgba(255,255,255,0.55);
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            margin-bottom: 8px;
            border-radius: 14px;
            color: rgba(255,255,255,0.86);
            transition: all 0.25s ease;
            font-size: 14px;
            font-weight: 500;
        }

            .menu a i {
                width: 18px;
                text-align: center;
                font-size: 15px;
            }

            .menu a:hover {
                background: var(--sidebar-hover);
                color: #fff;
                transform: translateX(4px);
            }

            .menu a.active {
                background: var(--sidebar-active);
                color: #fff;
                box-shadow: 0 10px 22px rgba(183,110,60,0.25);
            }

        .sidebar-footer {
            margin-top: 28px;
            padding: 14px;
            border-radius: 16px;
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.8);
            font-size: 13px;
            line-height: 1.7;
        }

        .main {
            flex: 1;
            margin-left: 280px;
            padding: 24px;
        }

        .topbar {
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 18px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            box-shadow: var(--shadow);
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .topbar-left h2 {
            font-size: 24px;
            font-weight: 700;
            color: #3f2d20;
            margin-bottom: 4px;
        }

        .topbar-left p {
            margin: 0;
            font-size: 13px;
            color: var(--muted);
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .top-pill {
            background: var(--primary-soft);
            color: var(--primary);
            border: 1px solid #f0ddca;
            padding: 10px 14px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #fff;
            border: 1px solid var(--border);
            padding: 8px 12px;
            border-radius: 999px;
        }

        .admin-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #d7a56d, #b76e3c);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .admin-info {
            line-height: 1.2;
        }

        .admin-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
        }

        .admin-role {
            font-size: 12px;
            color: var(--muted);
        }

        .logout-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 999px;
            background: #fff1f1;
            color: var(--danger);
            border: 1px solid #f0caca;
            font-size: 13px;
            font-weight: 600;
            transition: 0.25s ease;
        }

            .logout-link:hover {
                background: #ffe4e4;
                color: #c9302c;
                transform: translateY(-1px);
            }

        .page-shell {
            min-height: calc(100vh - 120px);
        }

        @@media (max-width: 992px) {
            .sidebar {
                width: 240px;
            }

            .main {
                margin-left: 240px;
            }
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: relative;
                width: 100%;
                min-height: auto;
                height: auto;
            }

            .main {
                margin-left: 0;
                padding: 16px;
            }

            .admin-layout {
                display: block;
            }

            .topbar {
                padding: 16px;
            }

            .topbar-left h2 {
                font-size: 20px;
            }
        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>
    <div class="admin-layout">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="fa-solid fa-gift"></i>
                </div>
                <div class="brand-text">
                    <div class="brand-title">BETSHOP Admin</div>
                    <div class="brand-subtitle">Quản trị web đồ lưu niệm</div>
                </div>
            </div>

            <div class="menu">
                <div class="menu-group">
                    <div class="menu-title">Tổng quan</div>
                    <a href="@Url.Action("Trangchu", "Admin")" class="active">
                        <i class="fas fa-chart-pie"></i>
                        <span>Dashboard</span>
                    </a>
                </div>

                <div class="menu-group">
                    <div class="menu-title">Quản lý sản phẩm</div>
                    <a href="@Url.Action("QuanLySanPham", "Admin")">
                        <i class="fas fa-box-open"></i>
                        <span>Sản phẩm</span>
                    </a>
                    <a href="@Url.Action("QuanLyLoaiSanPham", "Admin")">
                        <i class="fas fa-layer-group"></i>
                        <span>Loại sản phẩm</span>
                    </a>
                    <a href="@Url.Action("QuanLyChiTietSanPham", "Admin")">
                        <i class="fas fa-tags"></i>
                        <span>Chi tiết sản phẩm</span>
                    </a>
                    <a href="@Url.Action("QuanLySlide", "Admin")">
                        <i class="fas fa-images"></i>
                        <span>Slide</span>
                    </a>
                </div>

                <div class="menu-group">
                    <div class="menu-title">Bán hàng</div>
                    <a href="@Url.Action("DonHang", "Admin")">
                        <i class="fas fa-receipt"></i>
                        <span>Đơn hàng</span>
                    </a>
                    <a href="@Url.Action("QuanLyThanhToan", "Admin")">
                        <i class="fas fa-credit-card"></i>
                        <span>Thanh toán</span>
                    </a>
                </div>

                <div class="menu-group">
                    <div class="menu-title">Người dùng</div>
                    <a href="@Url.Action("QuanLyKhachHang", "Admin")">
                        <i class="fas fa-users"></i>
                        <span>Khách hàng</span>
                    </a>
                    <a href="@Url.Action("QuanLyDanhGia", "Admin")">
                        <i class="fas fa-star"></i>
                        <span>Đánh giá</span>
                    </a>
                </div>

                <div class="menu-group">
                    <div class="menu-title">Báo cáo</div>
                    <a href="@Url.Action("ThongKeDoanhThu", "Admin")">
                        <i class="fas fa-chart-line"></i>
                        <span>Thống kê doanh thu</span>
                    </a>
                </div>
            </div>

            <div class="sidebar-footer">
                Quản trị hệ thống BETSHOP theo các bảng:
                <strong>SanPham</strong>, <strong>LoaiSanPham</strong>,
                <strong>ChiTietSanPham</strong>, <strong>DonHang</strong>,
                <strong>ThanhToan</strong>, <strong>NguoiDung</strong>,
                <strong>DanhGia</strong>, <strong>Slide</strong>.
            </div>
        </aside>

        <main class="main">
            <div class="topbar">
                <div class="topbar-left">
                    <h2>@(ViewBag.Title ?? "Admin Dashboard")</h2>
                    <p>Quản lý sản phẩm, đơn hàng, khách hàng và thống kê của BETSHOP</p>
                </div>

                <div class="topbar-right">
                    <div class="top-pill">
                        <i class="fa-solid fa-store"></i> Shop đồ lưu niệm
                    </div>

                    <div class="admin-user">
                        <div class="admin-avatar">AD</div>
                        <div class="admin-info">
                            <div class="admin-name">Administrator</div>
                            <div class="admin-role">Quản trị hệ thống</div>
                        </div>
                    </div>

                    <a href="@Url.Action("DangXuat", "Home")" class="logout-link">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Đăng xuất</span>
                    </a>
                </div>
            </div>

            <div class="page-shell">
                @RenderBody()
            </div>
        </main>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>