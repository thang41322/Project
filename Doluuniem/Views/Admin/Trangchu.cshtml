@{
    ViewBag.Title = "Trang chủ Admin";
    Layout = "~/Views/Shared/Admin.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

<style>
    body {
        font-family: Arial, sans-serif;
        background: #fff8f3;
        color: #333;
    }

    .dashboard {
        max-width: 1200px;
        margin: 30px auto;
        padding: 0 15px;
    }

    .welcome-box {
        background: linear-gradient(135deg, #fff3e8, #ffffff);
        border: 1px solid #f3d2b8;
        border-radius: 18px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 8px 22px rgba(0,0,0,0.06);
    }

        .welcome-box h2 {
            margin: 0 0 10px;
            color: #d35400;
            font-size: 30px;
            font-weight: bold;
        }

        .welcome-box p {
            margin: 0;
            color: #7a5c47;
            font-size: 15px;
            line-height: 1.6;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: #fff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        border: 1px solid #f2dfd3;
        transition: 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

        .stat-top i {
            font-size: 24px;
            color: #e67e22;
        }

    .stat-title {
        color: #8a6b55;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: bold;
        color: #d35400;
    }

    .section-title {
        margin-bottom: 14px;
        color: #c96a16;
        font-size: 22px;
        font-weight: bold;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .feature-card {
        background: #fff;
        border-radius: 16px;
        padding: 22px;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        border: 1px solid #f2dfd3;
        transition: 0.2s ease;
        display: block;
    }

        .feature-card:hover {
            transform: translateY(-4px);
            background: #fffaf6;
        }

    .feature-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #fff3e8;
        color: #e67e22;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 14px;
    }

    .feature-card h4 {
        margin: 0 0 8px;
        color: #d35400;
        font-size: 18px;
    }

    .feature-card p {
        margin: 0;
        color: #7b6a5c;
        font-size: 14px;
        line-height: 1.6;
    }

    .info-box {
        margin-top: 28px;
        background: #fff;
        border-radius: 16px;
        padding: 20px 22px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        border: 1px solid #f2dfd3;
    }

        .info-box h3 {
            margin: 0 0 10px;
            color: #d35400;
        }

        .info-box ul {
            margin: 0;
            padding-left: 20px;
            color: #666;
            line-height: 1.8;
        }

    @@media (max-width: 992px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .feature-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .stats-grid,
        .feature-grid {
            grid-template-columns: 1fr;
        }

        .welcome-box h2 {
            font-size: 24px;
        }
    }
</style>

<div class="dashboard">
    <div class="welcome-box">
        <h2><i class="fa-solid fa-gauge-high"></i> Trang chủ quản trị</h2>
        <p>
            Chào mừng bạn đến với hệ thống quản trị website bán đồ lưu niệm.
            Tại đây bạn có thể quản lý sản phẩm, khách hàng, đơn hàng, doanh thu và nội dung hiển thị trên website.
        </p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-title">Tổng sản phẩm</div>
                <i class="fa-solid fa-box"></i>
            </div>
            <div class="stat-value">120</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-title">Đơn hàng</div>
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <div class="stat-value">58</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-title">Khách hàng</div>
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="stat-value">340</div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-title">Doanh thu</div>
                <i class="fa-solid fa-coins"></i>
            </div>
            <div class="stat-value">25M</div>
        </div>
    </div>

    <div class="section-title">Chức năng quản trị</div>

    <div class="feature-grid">
        <a href="@Url.Action("QuanLySanPham", "Admin")" class="feature-card">
            <div class="feature-icon">
                <i class="fa-solid fa-gift"></i>
            </div>
            <h4>Quản lý sản phẩm</h4>
            <p>Thêm, sửa, xóa và cập nhật thông tin các sản phẩm đồ lưu niệm.</p>
        </a>

        <a href="@Url.Action("QuanLyDonHang", "Admin")" class="feature-card">
            <div class="feature-icon">
                <i class="fa-solid fa-receipt"></i>
            </div>
            <h4>Quản lý đơn hàng</h4>
            <p>Theo dõi trạng thái đơn hàng, xác nhận và xử lý đơn của khách hàng.</p>
        </a>

        <a href="@Url.Action("QuanLyKhachHang", "Admin")" class="feature-card">
            <div class="feature-icon">
                <i class="fa-solid fa-user-group"></i>
            </div>
            <h4>Quản lý khách hàng</h4>
            <p>Xem danh sách tài khoản, khóa hoặc mở khóa người dùng trong hệ thống.</p>
        </a>

        <a href="@Url.Action("ThongKeDoanhThu", "Admin")" class="feature-card">
            <div class="feature-icon">
                <i class="fa-solid fa-chart-column"></i>
            </div>
            <h4>Thống kê doanh thu</h4>
            <p>Xem báo cáo doanh thu theo thời gian để theo dõi hiệu quả kinh doanh.</p>
        </a>

        <a href="@Url.Action("QuanLyLoaiSanPham", "Admin")" class="feature-card">
            <div class="feature-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <h4>Loại sản phẩm</h4>
            <p>Quản lý danh mục và phân loại sản phẩm để hiển thị rõ ràng hơn.</p>
        </a>

        <a href="@Url.Action("QuanLySlide", "Admin")" class="feature-card">
            <div class="feature-icon">
                <i class="fa-solid fa-images"></i>
            </div>
            <h4>Quản lý slide</h4>
            <p>Cập nhật banner, hình ảnh nổi bật và nội dung hiển thị ở trang chủ.</p>
        </a>
    </div>

    <div class="info-box">
        <h3><i class="fa-solid fa-circle-info"></i> Gợi ý sử dụng</h3>
        <ul>
            <li>Kiểm tra đơn hàng mới mỗi ngày để xác nhận nhanh cho khách.</li>
            <li>Cập nhật sản phẩm và hình ảnh thường xuyên để website luôn hấp dẫn.</li>
            <li>Theo dõi thống kê doanh thu để đánh giá hiệu quả bán hàng.</li>
        </ul>
    </div>
</div>