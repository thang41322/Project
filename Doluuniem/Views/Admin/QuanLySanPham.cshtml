@model IEnumerable<Doluuniem.Models.SanPham>

@{
    ViewBag.Title = "Quản Lý Sản Phẩm";
    Layout = "~/Views/Shared/Admin.cshtml";
}

<style>
    .container {
        max-width: 1200px;
        margin: 30px auto;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .header-section h2 {
            font-size: 24px;
            color: #3b2f1e;
        }

    .btn-add {
        background: #c8913a;
        color: white;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-add:hover {
            background: #a8742f;
        }

    .table-box {
        background: white;
        border-radius: 15px;
        padding: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #3b2f1e;
        color: white;
        padding: 12px;
    }

    td {
        padding: 12px;
        text-align: center;
        border-bottom: 1px solid #eee;
    }

    tr:hover {
        background: #faf7f2;
    }

    /* Ảnh */
    .product-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 10px;
    }

    /* Badge */
    .badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .in-stock {
        background: #e8f8f0;
        color: #27ae60;
    }

    .low-stock {
        background: #fff3cd;
        color: #f39c12;
    }

    .out-stock {
        background: #fdecea;
        color: #e74c3c;
    }

    /* Button */
    .btn {
        padding: 5px 10px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
    }

    .btn-edit {
        background: #f1c40f;
    }

    .btn-delete {
        background: #e74c3c;
        color: white;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        justify-content: center;
    }
    .btn-add {
        background: #27ae60;
        color: white;
    }

        .btn-add:hover {
            background: #1e8449;
        }
</style>

<div class="container">

    <div class="header-section">
        <h2>🎁 Quản lý sản phẩm lưu niệm</h2>
        <a href="@Url.Action("ThemSanPham","Admin")" class="btn-add">+ Thêm sản phẩm</a>
    </div>

    <div class="table-box">
        <table>
            <thead>
                <tr>
                    <th>Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th scope="col">Mô Tả</th>
                    <th>Mã loại sp</th>
                    <th>Giá</th>
                    <th>Tồn kho</th>
                    <th>Trạng thái</th>
                    <th scope="col">Màu Sắc</th>
                    <th scope="col">Kích Thước</th>
                    <th>Hành động</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var sp in Model)
                    {
                        var status = "in-stock";
                        var text = "Còn hàng";

                        if (sp.SoLuongTon == 0)
                        {
                            status = "out-stock";
                            text = "Hết hàng";
                        }
                        else if (sp.SoLuongTon < 5)
                        {
                            status = "low-stock";
                            text = "Sắp hết";
                        }

                        <tr>
                            <td>
                                <img src="@Url.Content("~/anh/anh/" + sp.HinhAnh)" class="product-img" />
                            </td>

                            <td>@sp.TenSanPham</td>
                            <td class="description">@sp.MoTa</td>

                            <td>@sp.MaLoaiSanPham</td> <!-- bạn có thể đổi thành danh mục thật -->

                            <td style="color:#c0392b;font-weight:bold">
                                @string.Format("{0:N0}đ", sp.DonGia)
                            </td>

                            <td>@sp.SoLuongTon</td>

                            <td>
                                <span class="badge @status">@text</span>
                            </td>

                            <td>@sp.MauSac</td>
                            <td>@sp.KichThuoc</td>

                            <td>
                                <div class="action-buttons">

                                    <!-- Thêm -->
                                    <a href="@Url.Action("ThemSanPham","Admin")" class="btn btn-add">
                                        <i class="fas fa-plus"></i>
                                    </a>

                                    <!-- Sửa -->
                                    <a href="@Url.Action("SuaSanPham","Admin", new { id = sp.MaSanPham })"
                                       class="btn btn-edit">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <!-- Xóa -->
                                    <a href="@Url.Action("XoaSanPham","Admin", new { id = sp.MaSanPham })"
                                       class="btn btn-delete"
                                       onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');">
                                        <i class="fas fa-trash"></i>
                                    </a>

                                </div>  
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">Không có sản phẩm</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>