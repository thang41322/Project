@model Doluuniem.Models.SanPham

@{
    Layout = "~/Views/Shared/Admin.cshtml";
    ViewBag.Title = "Sửa Sản Phẩm";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    .form-box {
        max-width: 800px;
        margin: 30px auto;
        background: #fff;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

    .form-title {
        font-size: 24px;
        margin-bottom: 20px;
        color: #3b2f1e;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

        .form-control:focus {
            border-color: #c8913a;
            outline: none;
            box-shadow: 0 0 0 2px rgba(200,145,58,0.2);
        }

    .form-row {
        display: flex;
        gap: 15px;
    }

        .form-row .form-group {
            flex: 1;
        }

    .preview-img {
        width: 120px;
        border-radius: 10px;
        margin-top: 10px;
    }

    .btn-submit {
        background: #c8913a;
        color: white;
        padding: 12px;
        border: none;
        border-radius: 10px;
        width: 100%;
    }
</style>

<div class="form-box">

    <div class="form-title">✏️ Sửa sản phẩm</div>

    @using (Html.BeginForm("SuaSanPham", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.HiddenFor(m => m.MaSanPham)

        <div class="form-group">
            <label>Tên sản phẩm</label>
            @Html.TextBoxFor(m => m.TenSanPham, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Mô tả</label>
            @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control" })
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Giá</label>
                @Html.TextBoxFor(m => m.DonGia, new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Số lượng</label>
                @Html.TextBoxFor(m => m.SoLuongTon, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <label>Danh mục</label>
            @Html.DropDownListFor(m => m.MaLoaiSanPham,
                new SelectList(ViewBag.LoaiSanPham, "MaLoaiSanPham", "TenLoai"),
                "-- Chọn danh mục --",
                new { @class = "form-control" })
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Màu sắc</label>
                @Html.TextBoxFor(m => m.MauSac, new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Kích thước</label>
                @Html.TextBoxFor(m => m.KichThuoc, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <label>Ảnh hiện tại</label><br />
            <img src="~/anh/anh/@Model.HinhAnh" class="preview-img" />
        </div>

        <div class="form-group">
            <label>Chọn ảnh mới</label>
            <input type="file" name="uploadAnh" class="form-control" />
        </div>

        <button type="submit" class="btn-submit">
            💾 Lưu thay đổi
        </button>
    }
</div>