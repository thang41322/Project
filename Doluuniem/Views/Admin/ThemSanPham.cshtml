@model Doluuniem.Models.SanPham

@{
    Layout = "~/Views/Shared/Admin.cshtml";
    ViewBag.Title = "Thêm Sản Phẩm";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    .form-container {
        max-width: 800px;
        margin: 30px auto;
        background: #fff;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

    .form-title {
        font-size: 24px;
        margin-bottom: 20px;
        color: #3b2f1e;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            font-weight: 500;
            margin-bottom: 5px;
            display: block;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ddd;
        transition: 0.3s;
    }

        .form-control:focus {
            border-color: #c8913a;
            outline: none;
            box-shadow: 0 0 0 2px rgba(200,145,58,0.2);
        }

    .form-row {
        display: flex;
        gap: 15px;
    }

        .form-row .form-group {
            flex: 1;
        }

    .btn-submit {
        background: #c8913a;
        color: white;
        padding: 12px;
        border: none;
        border-radius: 10px;
        width: 100%;
        font-size: 16px;
        transition: 0.3s;
    }

        .btn-submit:hover {
            background: #a8742f;
        }
</style>

<div class="form-container">

    <div class="form-title">
        🎁 Thêm sản phẩm lưu niệm
    </div>

    @using (Html.BeginForm("ThemSanPham", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="form-group">
            <label><i class="fas fa-gift"></i> Tên sản phẩm</label>
            <input type="text" name="TenSanPham" class="form-control" required />
        </div>

        <div class="form-group">
            <label><i class="fas fa-align-left"></i> Mô tả</label>
            <textarea name="MoTa" class="form-control"></textarea>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label><i class="fas fa-money-bill"></i> Giá</label>
                <input type="number" name="Gia" class="form-control" required />
            </div>

            <div class="form-group">
                <label><i class="fas fa-box"></i> Số lượng</label>
                <input type="number" name="SoLuong" class="form-control" required />
            </div>
        </div>

        <div class="form-group">
            <label><i class="fas fa-image"></i> Hình ảnh</label>
            <input type="file" name="HinhAnh" class="form-control" />
        </div>

        <div class="form-group">
            <label><i class="fas fa-list"></i> Danh mục</label>
            <select name="MaLoaiSanPham" class="form-control">
                @foreach (var loai in ViewBag.LoaiSanPham)
                {
                    <option value="@loai.MaLoaiSanPham">@loai.TenLoai</option>
                }
            </select>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label><i class="fas fa-palette"></i> Màu sắc</label>
                <input type="text" name="MauSac" class="form-control" placeholder="Ví dụ: Đỏ, Vàng..." />
            </div>

            <div class="form-group">
                <label><i class="fas fa-ruler"></i> Kích thước</label>
                <input type="text" name="KichThuoc" class="form-control" placeholder="Ví dụ: 10cm x 5cm" />
            </div>
        </div>

        <button type="submit" class="btn-submit">
            <i class="fas fa-plus"></i> Thêm sản phẩm
        </button>
    }
</div>