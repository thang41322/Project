@model Doluuniem.Models.NguoiDung
@{
    ViewBag.Title = "Thông Tin Khách Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary: #b76e3c;
        --primary-dark: #8f5430;
        --primary-soft: #fff6ef;
        --secondary: #e8b07a;
        --accent: #d94f4f;
        --text: #2f2a26;
        --muted: #7a6f66;
        --border: #f1e3d5;
        --shadow: 0 10px 28px rgba(0,0,0,0.08);
    }

    .profile-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .profile-header {
        background: linear-gradient(135deg, #fff8f1, #ffffff);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 28px;
        box-shadow: var(--shadow);
        margin-bottom: 24px;
    }

    .profile-title {
        margin: 0 0 8px;
        font-size: 2rem;
        font-weight: 800;
        color: #3f2d20;
    }

    .profile-subtitle {
        margin: 0;
        color: var(--muted);
        line-height: 1.8;
    }

    .profile-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 24px;
        align-items: start;
    }

    .card-box {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .card-body {
        padding: 24px;
    }

    .profile-sidebar {
        text-align: center;
    }

    .avatar-wrap {
        width: 170px;
        height: 170px;
        margin: 0 auto 18px;
        border-radius: 50%;
        padding: 6px;
        background: linear-gradient(135deg, var(--secondary), var(--primary));
        box-shadow: 0 12px 28px rgba(183,110,60,0.18);
    }

    .avatar-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 5px solid #fff;
        background: #fffaf6;
    }

    .profile-name {
        font-size: 1.35rem;
        font-weight: 800;
        color: #3f2d20;
        margin-bottom: 6px;
    }

    .profile-role {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: #fff6ef;
        color: var(--primary);
        border: 1px solid #efd8c2;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .profile-note {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.8;
        margin: 0;
    }

    .section-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #3f2d20;
        margin-bottom: 18px;
    }

    .info-list {
        display: grid;
        gap: 14px;
    }

    .info-row {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 14px;
        align-items: start;
        padding: 14px 0;
        border-bottom: 1px solid #f4ebe3;
    }

    .info-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .info-label {
        font-weight: 700;
        color: #4a3425;
    }

    .info-value {
        color: var(--text);
        line-height: 1.8;
        word-break: break-word;
    }

    .profile-actions {
        margin-top: 22px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .btn-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 46px;
        padding: 0 16px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.25s ease;
        border: 1px solid transparent;
    }

    .btn-edit {
        background: linear-gradient(135deg, var(--secondary), var(--primary));
        color: #fff;
    }

    .btn-edit:hover {
        color: #fff;
        opacity: 0.96;
        transform: translateY(-1px);
    }

    .btn-home {
        background: #fff7ed;
        color: var(--primary);
        border-color: #efd7bf;
    }

    .btn-home:hover {
        background: var(--primary-soft);
        color: var(--primary-dark);
    }

    .btn-password {
        background: #f5f5f5;
        color: #555;
        border-color: #e7e7e7;
    }

    .btn-password:hover {
        background: #ececec;
        color: #333;
    }

    .mini-card {
        margin-top: 18px;
        padding: 16px;
        border-radius: 18px;
        background: #fffaf6;
        border: 1px solid #f0e0d0;
        text-align: left;
    }

    .mini-card-title {
        font-size: 15px;
        font-weight: 800;
        color: #3f2d20;
        margin-bottom: 8px;
    }

    .mini-card-text {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
    }

    @@media (max-width: 992px) {
        .profile-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .profile-header,
        .card-body {
            padding: 20px;
        }

        .profile-title {
            font-size: 1.6rem;
        }

        .info-row {
            grid-template-columns: 1fr;
            gap: 4px;
        }

        .profile-actions {
            flex-direction: column;
        }

        .btn-custom {
            width: 100%;
        }
    }
</style>

@{
    var avatarPath = !string.IsNullOrEmpty(Model.Avatar)
        ? Url.Content("~/anh/avata/" + Model.Avatar)
        : "https://via.placeholder.com/300x300?text=Avatar";
}

<div class="profile-page">
    <div class="profile-header">
        <h1 class="profile-title">Thông tin khách hàng</h1>
        <p class="profile-subtitle">
            Quản lý thông tin cá nhân của bạn để BETSHOP hỗ trợ đặt hàng, giao hàng và chăm sóc tốt hơn.
        </p>
    </div>

    <div class="profile-layout">
        <!-- CỘT TRÁI -->
        <div class="card-box">
            <div class="card-body profile-sidebar">
                <div class="avatar-wrap">
                    <img src="@avatarPath" alt="Avatar khách hàng" />
                </div>

                <div class="profile-name">
                    @(string.IsNullOrWhiteSpace(Model.HoTen) ? Model.TenDangNhap : Model.HoTen)
                </div>

                <div class="profile-role">
                    <i class="bi bi-person-badge me-1"></i> @Model.VaiTro
                </div>

                <p class="profile-note">
                    Cập nhật hồ sơ để việc mua sắm, đặt quà và giao hàng diễn ra nhanh chóng, chính xác hơn.
                </p>

                <div class="mini-card">
                    <div class="mini-card-title">Gợi ý từ BETSHOP</div>
                    <p class="mini-card-text">
                        Hãy kiểm tra kỹ số điện thoại và địa chỉ để shop có thể giao những món quà lưu niệm đến bạn thuận tiện nhất.
                    </p>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI -->
        <div class="card-box">
            <div class="card-body">
                <div class="section-title">Thông tin cá nhân</div>

                <div class="info-list">
                    <div class="info-row">
                        <div class="info-label">Tên đăng nhập</div>
                        <div class="info-value">@Model.TenDangNhap</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Họ và tên</div>
                        <div class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.HoTen) ? "Chưa cập nhật" : Model.HoTen)
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Email</div>
                        <div class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cập nhật" : Model.Email)
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Số điện thoại</div>
                        <div class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.SoDienThoai) ? "Chưa cập nhật" : Model.SoDienThoai)
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Địa chỉ</div>
                        <div class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)
                        </div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Vai trò tài khoản</div>
                        <div class="info-value">@Model.VaiTro</div>
                    </div>
                </div>

                <div class="profile-actions">
                    <a href="@Url.Action("ChinhSuaThongTin", "Home")" class="btn-custom btn-edit">
                        🛠 Chỉnh sửa thông tin
                    </a>

                    <a href="@Url.Action("Index", "Home")" class="btn-custom btn-home">
                        🏠 Về trang chủ
                    </a>

                    <a href="@Url.Action("Doimatkhau", "Thongke")" class="btn-custom btn-password">
                        🔒 Đổi mật khẩu
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>