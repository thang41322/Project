@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Chi Tiết Đơn Hàng";
}
@model Doluuniem.Models.ChiTietDonHangViewModel

<style>
    :root {
        --primary: #b76e3c;
        --primary-dark: #8f5430;
        --primary-soft: #fff6ef;
        --secondary: #e8b07a;
        --accent: #d94f4f;
        --text: #2f2a26;
        --muted: #7a6f66;
        --border: #f1e3d5;
        --shadow: 0 10px 28px rgba(0,0,0,0.08);
    }

    .order-detail-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        background: linear-gradient(135deg, #fff8f1, #ffffff);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 28px;
        box-shadow: var(--shadow);
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0 0 8px;
        font-size: 2rem;
        font-weight: 800;
        color: #3f2d20;
    }

    .page-subtitle {
        margin: 0;
        color: var(--muted);
        line-height: 1.8;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .info-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: var(--shadow);
        padding: 24px;
    }

    .info-card-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: #3f2d20;
        margin-bottom: 16px;
    }

    .info-list {
        display: grid;
        gap: 12px;
    }

    .info-row {
        display: grid;
        grid-template-columns: 140px 1fr;
        gap: 10px;
        align-items: start;
    }

    .info-label {
        font-weight: 700;
        color: #4a3425;
    }

    .info-value {
        color: var(--text);
        line-height: 1.8;
    }

    .total-amount {
        color: var(--accent);
        font-size: 1.25rem;
        font-weight: 800;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-pending {
        background: #fff4df;
        color: #b7791f;
    }

    .status-processing {
        background: #e9f5ff;
        color: #1f6fb7;
    }

    .status-shipping {
        background: #eef4ff;
        color: #4154b3;
    }

    .status-completed {
        background: #ebfaef;
        color: #2f8a44;
    }

    .status-cancelled {
        background: #fff1f1;
        color: #c0392b;
    }

    .status-default {
        background: #f4f4f4;
        color: #666;
    }

    .product-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .product-card-header {
        padding: 22px 24px;
        border-bottom: 1px solid #f2e5d9;
        background: #fffaf6;
    }

    .product-card-title {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 800;
        color: #3f2d20;
    }

    .table-wrap {
        overflow-x: auto;
    }

    .order-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
    }

    .order-table thead th {
        background: #fff8f2;
        color: #4a3425;
        font-size: 14px;
        font-weight: 800;
        padding: 16px 18px;
        border-bottom: 1px solid #f1e3d7;
        text-align: left;
        white-space: nowrap;
    }

    .order-table tbody td {
        padding: 16px 18px;
        border-bottom: 1px solid #f5ebe1;
        vertical-align: middle;
        color: var(--text);
        font-size: 14px;
    }

    .order-table tbody tr:hover {
        background: #fffdfb;
    }

    .product-name {
        font-weight: 700;
        color: #3f2d20;
    }

    .money {
        color: var(--accent);
        font-weight: 800;
        white-space: nowrap;
    }

    .action-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .btn-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 16px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        border: 1px solid transparent;
        transition: 0.25s ease;
        cursor: pointer;
    }

    .btn-back {
        background: #fff7ed;
        color: var(--primary);
        border-color: #efd7bf;
    }

    .btn-back:hover {
        background: var(--primary-soft);
        color: var(--primary-dark);
    }

    .btn-cancel {
        background: #fff1f1;
        color: #c0392b;
        border-color: #efc7c7;
    }

    .btn-cancel:hover {
        background: #e74c3c;
        color: #fff;
        border-color: #e74c3c;
    }

    .cannot-cancel {
        color: var(--muted);
        font-size: 14px;
        font-style: italic;
        padding: 10px 0;
    }

    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
        }

        .page-header,
        .info-card {
            padding: 20px;
            border-radius: 18px;
        }

        .page-title {
            font-size: 1.6rem;
        }

        .info-row {
            grid-template-columns: 1fr;
            gap: 4px;
        }
    }
</style>

@{
    var trangThai = (Model.DonHang.TrangThai ?? "").Trim().ToLower();
    string cssTrangThai = "status-default";

    if (trangThai == "chờ xác nhận" || trangThai == "cho xac nhan")
    {
        cssTrangThai = "status-pending";
    }
    else if (trangThai == "đang xử lý" || trangThai == "dang xu ly")
    {
        cssTrangThai = "status-processing";
    }
    else if (trangThai == "đang giao" || trangThai == "dang giao")
    {
        cssTrangThai = "status-shipping";
    }
    else if (trangThai == "hoàn thành" || trangThai == "hoan thanh")
    {
        cssTrangThai = "status-completed";
    }
    else if (trangThai == "đã hủy" || trangThai == "da huy")
    {
        cssTrangThai = "status-cancelled";
    }

    bool coTheHuy =
        trangThai == "chờ xác nhận" ||
        trangThai == "cho xac nhan" ||
        trangThai == "đang xử lý" ||
        trangThai == "dang xu ly";
}

<div class="order-detail-page">
    <div class="page-header">
        <h1 class="page-title">Chi tiết đơn hàng #@Model.DonHang.MaDonHang</h1>
        <p class="page-subtitle">
            Theo dõi thông tin đơn hàng và xem lại những món quà bạn đã đặt tại BETSHOP.
        </p>
    </div>

    <div class="info-grid">
        <div class="info-card">
            <div class="info-card-title">Thông tin đơn hàng</div>

            <div class="info-list">
                <div class="info-row">
                    <div class="info-label">Mã đơn hàng</div>
                    <div class="info-value">#@Model.DonHang.MaDonHang</div>
                </div>

                <div class="info-row">
                    <div class="info-label">Ngày đặt</div>
                    <div class="info-value">
                        @(Model.DonHang.NgayDat.HasValue ? Model.DonHang.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa cập nhật")
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">Trạng thái</div>
                    <div class="info-value">
                        <span class="status-badge @cssTrangThai">@Model.DonHang.TrangThai</span>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">Tổng tiền</div>
                    <div class="info-value">
                        <span class="total-amount">@String.Format("{0:N0}", Model.DonHang.TongTien) VNĐ</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="info-card">
            <div class="info-card-title">Thông tin khách hàng</div>

            <div class="info-list">
                <div class="info-row">
                    <div class="info-label">Khách hàng</div>
                    <div class="info-value">
                        @(Model.DonHang.NguoiDung != null ? Model.DonHang.NguoiDung.HoTen : "Chưa cập nhật")
                    </div>
                </div>

                @if (Model.DonHang.NguoiDung != null)
                {
                    <div class="info-row">
                        <div class="info-label">Tài khoản</div>
                        <div class="info-value">@Model.DonHang.NguoiDung.TenDangNhap</div>
                    </div>
                }

                <div class="info-row">
                    <div class="info-label">Ghi chú</div>
                    <div class="info-value">
                        Đơn hàng quà tặng lưu niệm được chuẩn bị theo thông tin bạn đã đặt.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="product-card">
        <div class="product-card-header">
            <h2 class="product-card-title">Sản phẩm trong đơn hàng</h2>
        </div>

        <div class="table-wrap">
            <table class="order-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ChiTietDonHangs)
                    {
                        <tr>
                            <td>
                                <span class="product-name">
                                    @(item.SanPham != null ? item.SanPham.TenSanPham : "Sản phẩm")
                                </span>
                            </td>
                            <td>@item.SoLuong</td>
                            <td>
                                <span class="money">@String.Format("{0:N0}", item.DonGia) VNĐ</span>
                            </td>
                            <td>
                                <span class="money">@String.Format("{0:N0}", item.SoLuong * item.DonGia) VNĐ</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="action-bar">
        <a href="@Url.Action("LichSuDonHang", "Home")" class="btn-custom btn-back">
            <i class="bi bi-arrow-left"></i> Quay lại lịch sử đơn hàng
        </a>

        @if (coTheHuy)
        {
            using (Html.BeginForm("HuyDonHang", "Home", FormMethod.Post, new { onsubmit = "return confirm('Bạn có chắc muốn hủy đơn hàng này không?');", style = "display:inline-block;" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.DonHang.MaDonHang" />
                <button type="submit" class="btn-custom btn-cancel">
                    <i class="bi bi-x-circle"></i> Hủy đơn hàng
                </button>
            }
        }
        else
        {
            <div class="cannot-cancel">Đơn hàng này hiện không thể hủy.</div>
        }
    </div>
</div>