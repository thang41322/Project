@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lịch Sử Đơn Hàng";
}
@model IEnumerable<Doluuniem.Models.DonHang>

<style>
    :root {
        --primary: #b76e3c;
        --primary-dark: #8f5430;
        --primary-soft: #fff6ef;
        --secondary: #e8b07a;
        --accent: #d94f4f;
        --text: #2f2a26;
        --muted: #7a6f66;
        --border: #f1e3d5;
        --shadow: 0 10px 28px rgba(0,0,0,0.08);
        --success-bg: #eefaf0;
        --success-text: #2e7d32;
        --error-bg: #fff1f1;
        --error-text: #c0392b;
    }

    .order-history-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        background: linear-gradient(135deg, #fff8f1, #ffffff);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 28px;
        box-shadow: var(--shadow);
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0 0 8px;
        font-size: 2rem;
        font-weight: 800;
        color: #3f2d20;
    }

    .page-subtitle {
        margin: 0;
        color: var(--muted);
        line-height: 1.8;
    }

    .custom-alert {
        padding: 14px 16px;
        border-radius: 14px;
        margin-bottom: 18px;
        font-weight: 600;
        border: 1px solid transparent;
    }

    .custom-alert.success {
        background: var(--success-bg);
        color: var(--success-text);
        border-color: #cfe9d2;
    }

    .custom-alert.error {
        background: var(--error-bg);
        color: var(--error-text);
        border-color: #f0caca;
    }

    .history-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .history-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 22px 24px;
        border-bottom: 1px solid #f2e5d9;
        flex-wrap: wrap;
    }

    .history-card-title {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 800;
        color: #3f2d20;
    }

    .history-card-note {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 14px;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .order-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

    .order-table thead th {
        background: #fff8f2;
        color: #4a3425;
        font-size: 14px;
        font-weight: 800;
        padding: 16px 18px;
        border-bottom: 1px solid #f1e3d7;
        text-align: left;
        white-space: nowrap;
    }

    .order-table tbody td {
        padding: 16px 18px;
        border-bottom: 1px solid #f5ebe1;
        vertical-align: middle;
        color: var(--text);
        font-size: 14px;
    }

    .order-table tbody tr:hover {
        background: #fffdfb;
    }

    .order-code {
        font-weight: 800;
        color: #3f2d20;
    }

    .order-date {
        color: var(--muted);
        white-space: nowrap;
    }

    .order-total {
        font-weight: 800;
        color: var(--accent);
        white-space: nowrap;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

    .status-pending {
        background: #fff4df;
        color: #b7791f;
    }

    .status-processing {
        background: #e9f5ff;
        color: #1f6fb7;
    }

    .status-shipping {
        background: #eef4ff;
        color: #4154b3;
    }

    .status-completed {
        background: #ebfaef;
        color: #2f8a44;
    }

    .status-cancelled {
        background: #fff1f1;
        color: #c0392b;
    }

    .status-default {
        background: #f4f4f4;
        color: #666;
    }

    .action-group {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-detail {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 40px;
        padding: 0 14px;
        border-radius: 12px;
        background: #fff7ed;
        color: var(--primary);
        border: 1px solid #efd7bf;
        text-decoration: none;
        font-weight: 700;
        transition: 0.25s ease;
        white-space: nowrap;
    }

    .btn-detail:hover {
        background: var(--primary-soft);
        color: var(--primary-dark);
    }

    .btn-cancel-order {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 40px;
        padding: 0 14px;
        border-radius: 12px;
        background: #fff1f1;
        color: #c0392b;
        border: 1px solid #efc7c7;
        font-weight: 700;
        cursor: pointer;
        transition: 0.25s ease;
        white-space: nowrap;
    }

    .btn-cancel-order:hover {
        background: #e74c3c;
        color: #fff;
        border-color: #e74c3c;
    }

    .cannot-cancel {
        color: var(--muted);
        font-size: 13px;
        font-style: italic;
    }

    .empty-state {
        padding: 40px 24px;
        text-align: center;
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: #fff6ef;
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .empty-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #3f2d20;
        margin-bottom: 8px;
    }

    .empty-text {
        color: var(--muted);
        margin-bottom: 18px;
        line-height: 1.8;
    }

    .btn-go-shopping {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, var(--secondary), var(--primary));
        color: #fff;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 14px;
        font-weight: 800;
        transition: 0.25s ease;
    }

    .btn-go-shopping:hover {
        color: #fff;
        opacity: 0.96;
        transform: translateY(-1px);
    }

    .bottom-link {
        margin-top: 20px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--primary);
        font-weight: 700;
        text-decoration: none;
    }

    .bottom-link:hover {
        color: var(--primary-dark);
    }

    @@media (max-width: 768px) {
        .page-header {
            padding: 20px;
            border-radius: 18px;
        }

        .page-title {
            font-size: 1.6rem;
        }

        .history-card-header {
            padding: 18px;
        }
    }
</style>

<div class="order-history-page">
    <div class="page-header">
        <h1 class="page-title">Lịch sử đơn hàng</h1>
        <p class="page-subtitle">
            Theo dõi các đơn hàng bạn đã đặt, xem chi tiết và hủy đơn khi đơn vẫn đang chờ xử lý.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="custom-alert success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="custom-alert error">
            @TempData["Error"]
        </div>
    }

    <div class="history-card">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-bag-heart"></i>
                </div>
                <div class="empty-title">Bạn chưa có đơn hàng nào</div>
                <div class="empty-text">
                    Hãy khám phá các món quà lưu niệm xinh xắn và tạo đơn hàng đầu tiên của bạn.
                </div>
                <a href="@Url.Action("SanPham", "Home")" class="btn-go-shopping">
                    <i class="bi bi-gift"></i> Mua sắm ngay
                </a>
            </div>
        }
        else
        {
            <div class="history-card-header">
                <div>
                    <h2 class="history-card-title">Danh sách đơn hàng</h2>
                    <p class="history-card-note">Tất cả đơn hàng gần đây của bạn sẽ hiển thị tại đây.</p>
                </div>
            </div>

            <div class="table-wrap">
                <table class="order-table">
                    <thead>
                        <tr>
                            <th>Mã đơn hàng</th>
                            <th>Ngày đặt</th>
                            <th>Trạng thái</th>
                            <th>Tổng tiền</th>
                            <th>Chi tiết</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var donHang in Model)
                        {
                            var trangThai = (donHang.TrangThai ?? "").Trim().ToLower();
                            string cssTrangThai = "status-default";

                            if (trangThai == "chờ xác nhận" || trangThai == "cho xac nhan")
                            {
                                cssTrangThai = "status-pending";
                            }
                            else if (trangThai == "đang xử lý" || trangThai == "dang xu ly")
                            {
                                cssTrangThai = "status-processing";
                            }
                            else if (trangThai == "đang giao" || trangThai == "dang giao")
                            {
                                cssTrangThai = "status-shipping";
                            }
                            else if (trangThai == "hoàn thành" || trangThai == "hoan thanh")
                            {
                                cssTrangThai = "status-completed";
                            }
                            else if (trangThai == "đã hủy" || trangThai == "da huy")
                            {
                                cssTrangThai = "status-cancelled";
                            }

                            bool coTheHuy =
                                trangThai == "chờ xác nhận" ||
                                trangThai == "cho xac nhan" ||
                                trangThai == "đang xử lý" ||
                                trangThai == "dang xu ly";

                            <tr>
                                <td>
                                    <span class="order-code">#@donHang.MaDonHang</span>
                                </td>
                                <td>
                                    @(donHang.NgayDat.HasValue ? donHang.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "")
                                </td>
                                <td>
                                    <span class="status-badge @cssTrangThai">@donHang.TrangThai</span>
                                </td>
                                <td>
                                    <span class="order-total">@String.Format("{0:N0}", donHang.TongTien)đ</span>
                                </td>
                                <td>
                                    <a class="btn-detail" href="@Url.Action("ChiTietDonHangKhachHang", "Home", new { id = donHang.MaDonHang })">
                                        <i class="bi bi-eye"></i>&nbsp;Xem chi tiết
                                    </a>
                                </td>
                                <td>
                                    @if (coTheHuy)
                                    {
                                        using (Html.BeginForm("HuyDonHang", "Admin", FormMethod.Post, new { onsubmit = "return confirm('Bạn có chắc muốn hủy đơn hàng này không?');", style = "display:inline-block;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@donHang.MaDonHang" />
                                            <button type="submit" class="btn-cancel-order">
                                                <i class="bi bi-x-circle"></i>&nbsp;Hủy đơn
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="cannot-cancel">Không thể hủy</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <a href="@Url.Action("Index", "Home")" class="bottom-link">
        <i class="bi bi-arrow-left"></i> Quay lại trang chủ
    </a>
</div>