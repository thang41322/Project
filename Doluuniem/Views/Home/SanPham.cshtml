@model IEnumerable<Doluuniem.Models.SanPham>

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/trangchu.cshtml";
}

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success text-center shadow-sm custom-toast">
        @TempData["ThongBao"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success shadow-sm mb-3 custom-alert-box">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger shadow-sm mb-3 custom-alert-box">
        @TempData["Error"]
    </div>
}

<style>
    :root {
        --primary: #b76e3c;
        --primary-dark: #8f5430;
        --primary-soft: #fff6ef;
        --secondary: #e8b07a;
        --accent: #d94f4f;
        --text: #2f2a26;
        --muted: #7a6f66;
        --white: #ffffff;
        --border: #f1e3d5;
        --shadow: 0 10px 28px rgba(0,0,0,0.08);
        --radius: 18px;
    }

    .custom-toast {
        position: fixed;
        top: 90px;
        right: 24px;
        z-index: 2000;
        border-radius: 12px;
        padding: 12px 18px;
    }

    .custom-alert-box {
        border-radius: 14px;
    }

    .home-section {
        margin-bottom: 28px;
    }

    /* HERO */
    .hero-box {
        position: relative;
        min-height: 460px;
        border-radius: 28px;
        overflow: hidden;
        background-image: url('@Url.Content("~/anh/anh1/z7633087461151_7bde9bbbb356583c856e0e303763f8e7.jpg")');
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        padding: 42px;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(47,31,20,0.85) 0%, rgba(47,31,20,0.60) 42%, rgba(47,31,20,0.18) 100%);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 620px;
        color: #fff;
    }

    .hero-badge {
        display: inline-block;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.16);
        color: #fff6ec;
        border-radius: 999px;
        padding: 8px 15px;
        font-size: 14px;
        margin-bottom: 16px;
    }

    .hero-title {
        font-size: 2.8rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 16px;
    }

    .hero-desc {
        font-size: 1rem;
        line-height: 1.8;
        color: #f5e8da;
        margin-bottom: 20px;
    }

    .hero-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 24px;
    }

    .hero-tag {
        background: rgba(255,255,255,0.14);
        color: #fff;
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 14px;
        border: 1px solid rgba(255,255,255,0.18);
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-hero-main {
        display: inline-block;
        background: linear-gradient(135deg, var(--secondary), var(--primary));
        color: #fff;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.3s ease;
    }

    .btn-hero-main:hover {
        color: #fff;
        transform: translateY(-2px);
    }

    .btn-hero-soft {
        display: inline-block;
        background: rgba(255,255,255,0.12);
        color: #fff;
        padding: 12px 22px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.18);
        transition: 0.3s ease;
    }

    .btn-hero-soft:hover {
        color: #fff;
        background: rgba(255,255,255,0.18);
    }

    /* INTRO CARDS */
    .intro-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
    }

    .intro-card {
        background: #fff;
        border-radius: 20px;
        padding: 22px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    .intro-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-soft);
        color: var(--primary);
        font-size: 24px;
        margin-bottom: 14px;
    }

    .intro-card h4 {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: #3f2d20;
    }

    .intro-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
        font-size: 0.95rem;
    }

    /* PRODUCT SECTION */
    .product-section-box {
        background: #fff;
        border-radius: 24px;
        padding: 26px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 14px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .section-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: #3f2d20;
        margin: 0;
    }

    .section-subtitle {
        margin: 6px 0 0;
        color: var(--muted);
    }

    .view-all-link {
        color: var(--primary);
        font-weight: 700;
        text-decoration: none;
    }

    .view-all-link:hover {
        color: var(--primary-dark);
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 20px;
    }

    .product-card {
        position: relative;
        background: linear-gradient(180deg, #fff, #fffaf6);
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #f4e7da;
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 28px rgba(0,0,0,0.09);
    }

    .product-image-wrap {
        position: relative;
        padding: 14px;
        background: #fff8f1;
    }

    .product-card img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 14px;
    }

    .tag-hot {
        position: absolute;
        top: 18px;
        left: 18px;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        padding: 6px 10px;
        border-radius: 999px;
        z-index: 2;
    }

    .product-body {
        padding: 18px;
    }

    .product-name {
        font-size: 1.04rem;
        font-weight: 700;
        line-height: 1.5;
        min-height: 48px;
        margin-bottom: 8px;
    }

    .product-name a {
        color: var(--text);
        text-decoration: none;
    }

    .product-name a:hover {
        color: var(--primary);
    }

    .price {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--accent);
        margin-bottom: 10px;
    }

    .desc {
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.7;
        min-height: 45px;
        margin-bottom: 14px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .button-group {
        display: flex;
        gap: 10px;
    }

    .btn-cart {
        width: 46px;
        height: 44px;
        border: 1px solid #efcfaa;
        background: #fff7ed;
        color: var(--primary);
        border-radius: 12px;
        transition: 0.25s ease;
    }

    .btn-cart:hover {
        background: var(--primary);
        color: #fff;
    }

    .buy-now {
        flex: 1;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--secondary), var(--primary));
        color: #fff;
        font-weight: 700;
        padding: 10px 14px;
        transition: 0.25s ease;
    }

    .buy-now:hover {
        opacity: 0.96;
        transform: translateY(-1px);
    }

    /* STORY */
    .story-box {
        background: linear-gradient(135deg, #fff8f1, #ffffff);
        border-radius: 24px;
        padding: 30px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    .story-title {
        font-size: 1.7rem;
        font-weight: 800;
        color: #3f2d20;
        margin-bottom: 14px;
    }

    .story-text {
        margin: 0;
        color: var(--muted);
        line-height: 1.9;
        font-size: 1rem;
        max-width: 850px;
    }

    /* PAGINATION */
    .pagination-container {
        margin-top: 28px;
        display: flex;
        justify-content: center;
    }

    .pagination {
        list-style: none;
        display: flex;
        gap: 10px;
        padding-left: 0;
        margin-bottom: 0;
        flex-wrap: wrap;
    }

    .pagination li a {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        height: 42px;
        padding: 0 14px;
        border-radius: 12px;
        text-decoration: none;
        background: #fff;
        border: 1px solid var(--border);
        color: var(--text);
        font-weight: 600;
    }

    .pagination li.active a {
        background: linear-gradient(135deg, var(--secondary), var(--primary));
        color: #fff;
        border-color: transparent;
    }

    .pagination li.disabled a {
        pointer-events: none;
        opacity: 0.5;
    }

    @@media (max-width: 768px) {
        .hero-box {
            min-height: 390px;
            padding: 24px;
            border-radius: 20px;
        }

        .hero-title {
            font-size: 2rem;
        }

        .section-title,
        .story-title {
            font-size: 1.45rem;
        }

        .product-section-box,
        .story-box {
            padding: 20px;
        }

        .product-grid {
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        }

        .product-card img {
            height: 190px;
        }
    }
</style>

<div class="home-section">
    <section class="hero-box">
        <div class="hero-overlay"></div>

        <div class="hero-content">
            <span class="hero-badge">
                <i class="bi bi-gift-fill me-1"></i> Quà lưu niệm dành cho mọi khoảnh khắc đẹp
            </span>

            <h1 class="hero-title">
                Quà tặng xinh xắn,<br />
                lưu giữ yêu thương
            </h1>

            <p class="hero-desc">
                Khám phá những món quà lưu niệm, đồ handmade và phụ kiện trang trí nhỏ xinh
                giúp bạn gửi gắm tình cảm đến người thân, bạn bè và những người quan trọng.
            </p>

            <div class="hero-tags">
                <span class="hero-tag"><i class="bi bi-truck me-1"></i> Freeship đơn từ 299K</span>
                <span class="hero-tag"><i class="bi bi-box2-heart me-1"></i> Gói quà chỉn chu</span>
                <span class="hero-tag"><i class="bi bi-stars me-1"></i> Nhiều mẫu độc đáo</span>
            </div>

            <div class="hero-actions">
                <a href="@Url.Action("SanPham", "Home")" class="btn-hero-main">Khám phá sản phẩm</a>
                <a href="#sanphamnoibat" class="btn-hero-soft">Xem nổi bật</a>
            </div>
        </div>
    </section>
</div>

<div class="home-section">
    <div class="intro-grid">
        <div class="intro-card">
            <div class="intro-icon"><i class="bi bi-patch-check"></i></div>
            <h4>Quà tặng chọn lọc</h4>
            <p>Những món quà nhỏ xinh, dễ thương và phù hợp với nhiều dịp tặng khác nhau.</p>
        </div>

        <div class="intro-card">
            <div class="intro-icon"><i class="bi bi-heart"></i></div>
            <h4>Thiết kế đầy cảm xúc</h4>
            <p>Mỗi sản phẩm đều mang phong cách ấm áp, gần gũi và phù hợp làm quà lưu niệm.</p>
        </div>

        <div class="intro-card">
            <div class="intro-icon"><i class="bi bi-box-seam"></i></div>
            <h4>Đóng gói đẹp mắt</h4>
            <p>Hỗ trợ gói quà cẩn thận để món quà của bạn trở nên tinh tế hơn khi trao tặng.</p>
        </div>
    </div>
</div>

<div class="home-section" id="sanphamnoibat">
    <section class="product-section-box">
        <div class="section-head">
            <div>
                <h2 class="section-title">Sản phẩm nổi bật</h2>
                <p class="section-subtitle">Những món quà được nhiều khách hàng yêu thích</p>
            </div>

            <a class="view-all-link" href="@Url.Action("SanPham", "Home")">
                Xem tất cả <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="product-grid">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image-wrap">
                        <span class="tag-hot">HOT</span>

                        <a href="@Url.Action("ChiTietSanPham", "Home", new { id = item.MaSanPham })">
                            <img src="@Url.Content("~/anh/anh/" + item.HinhAnh)" alt="@item.TenSanPham" />
                        </a>
                    </div>

                    <div class="product-body">
                        <div class="product-name">
                            <a href="@Url.Action("ChiTietSanPham", "Home", new { id = item.MaSanPham })">
                                @item.TenSanPham
                            </a>
                        </div>

                        <div class="price">
                            @String.Format("{0:N0}", item.DonGia) ₫
                        </div>

                        <p class="desc">
                            @item.MoTa
                        </p>

                        <div class="button-group">
                            <form method="post" action="@Url.Action("ThemVaoGioHang", "Home")">
                                <input type="hidden" name="maSanPham" value="@item.MaSanPham" />
                                <button type="submit" class="btn-cart" title="Thêm vào giỏ hàng">
                                    <i class="bi bi-cart-plus"></i>
                                </button>
                            </form>

                            <form method="get" action="@Url.Action("MuaHang", "Home")" style="flex:1;">
                                <input type="hidden" name="id" value="@item.MaSanPham" />
                                <button type="submit" class="buy-now w-100">
                                    Mua ngay
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="pagination-container">
            <ul class="pagination">
                <li class="@(ViewBag.TrangHienTai == 1 ? "disabled" : "")">
                    <a href="@Url.Action("Index", "Home", new { page = ViewBag.TrangHienTai - 1 })">«</a>
                </li>

                @for (int i = 1; i <= ViewBag.TongSoTrang; i++)
                {
                    <li class="@(i == ViewBag.TrangHienTai ? "active" : "")">
                        <a href="@Url.Action("Index", "Home", new { page = i })">@i</a>
                    </li>
                }

                <li class="@(ViewBag.TrangHienTai == ViewBag.TongSoTrang ? "disabled" : "")">
                    <a href="@Url.Action("Index", "Home", new { page = ViewBag.TrangHienTai + 1 })">»</a>
                </li>
            </ul>
        </div>
    </section>
</div>

<div class="home-section">
    <section class="story-box">
        <h2 class="story-title">Một món quà nhỏ, một kỷ niệm đáng nhớ</h2>
        <p class="story-text">
            BETSHOP mong muốn mang đến những món quà lưu niệm tinh tế, dễ thương và giàu cảm xúc.
            Không chỉ là sản phẩm, mỗi món quà còn là cách để bạn lưu giữ kỷ niệm và gửi đi yêu thương
            trong những dịp thật đặc biệt.
        </p>
    </section>
</div>

<script>
    setTimeout(function () {
        const toast = document.querySelector('.custom-toast');
        if (toast) {
            toast.style.transition = '0.4s';
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 400);
        }
    }, 2500);
</script>